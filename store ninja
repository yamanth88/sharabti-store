body {
    margin: 0;
    min-height: 100vh;

    display: flex;
    justify-content: center;
    align-items: center;

    background: #111;
    color: white;

    font-family: Arial, sans-serif;
}

.product {
    width: 300px;
    padding: 40px;

    text-align: center;

    background: #222;
    border-radius: 20px;
}

.description {
    color: #aaa;
}

button {
    padding: 12px 25px;

    border: none;
    border-radius: 8px;

    background: #00c853;
    color: white;

    font-size: 16px;
    cursor: pointer;
}

button:hover {
    background: #00a844;
}

#message {
    color: #00c853;
}
